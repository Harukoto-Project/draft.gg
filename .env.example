# 秘密情報は .env にだけ書く。ここにはキー名と、秘密ではない既定値だけを置く。

# MySQL の接続文字列(api / worker / マイグレーションが使う)。値は .env にだけ書く。
# 形式: mysql://<ユーザー>:<パスワード>@<ホスト>:<ポート>/<データベース名>
# データベースは utf8mb4 で作成しておく(例: CREATE DATABASE draftgg CHARACTER SET utf8mb4;)
DATABASE_URL=

# Cloudflare Workers のローカル実行(`pnpm --filter @draftgg/api dev:worker`)で、Hyperdrive の代わりに
# 直接つなぐ DB の接続文字列(形式は DATABASE_URL と同じ)。値は .env にだけ書く。
# ユーザーの認証プラグインは caching_sha2_password か mysql_native_password にする(Hyperdrive の対応範囲)
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=

# api(Hono)の待ち受け。外部には cloudflared 経由でのみ公開するので 127.0.0.1 のままにする
API_HOST=127.0.0.1
API_PORT=3001

# web(Next.js)の待ち受けポート(systemd の `next start` が参照する)
WEB_PORT=3000

# Discord ログイン(Better Auth)。4つとも空ならログインなしで動く。一部だけ書くと起動時にエラーになる。値は .env にだけ書く。
# BETTER_AUTH_URL: ブラウザからアクセスする公開URL(例: https://draft.example.com)。Cookie と OAuth の戻り先になる
# BETTER_AUTH_SECRET: 32文字以上のランダムな文字列(例: openssl rand -base64 32)
# DISCORD_CLIENT_ID / DISCORD_CLIENT_SECRET: Discord Developer Portal の OAuth2 で発行する
#   Redirects には `<BETTER_AUTH_URL>/api/auth/callback/discord` を登録する
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# 任意。未設定なら公開フォルダの当年 CSV を使う。直リンクに差し替えるときだけ書く。
ORACLES_ELIXIR_CSV_URL=

# Leaguepedia の bot。無いときはピック順の補完をスキップする。値は .env にだけ書く。
LEAGUEPEDIA_BOT_USERNAME=
LEAGUEPEDIA_BOT_PASSWORD=
