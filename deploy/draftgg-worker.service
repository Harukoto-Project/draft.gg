# 定期バッチ(worker)。/etc/systemd/system/ に置いて使うひな形。
# 配置先(/opt/draftgg)・実行ユーザー・node のパスは環境に合わせて変更する。
[Unit]
Description=Draft.GG worker (scheduled jobs)
After=network.target mysql.service

[Service]
Type=simple
User=draftgg
Group=draftgg
WorkingDirectory=/opt/draftgg/apps/worker
# 先頭の "-" で、.env がまだ無くても起動できるようにする
EnvironmentFile=-/opt/draftgg/.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node dist/index.js
Restart=always
RestartSec=10
KillSignal=SIGTERM
# 停止時は再試行の待ちを中断し、実行中の1試行(Data Dragon の取得は1リクエスト 15 秒で打ち切り)だけを待つ
TimeoutStopSec=60

# 権限の絞り込み
# ProtectHome=true は /home と /root を隠す。pnpm はストアとプロジェクトが別のファイルシステムだと
# node_modules からストアへシンボリックリンクを作るため、ストアがホーム配下にあると起動に失敗する。
# pnpm のストアは /opt/draftgg 配下(プロジェクトと同じファイルシステム。例: store-dir=/opt/draftgg/.pnpm-store)に置く。
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
