{
  "name": "@draftgg/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@draftgg/data-sources": "workspace:*",
    "@draftgg/db": "workspace:*",
    "@draftgg/shared": "workspace:*",
    "node-cron": "^4.6.0"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "vitest": "^5.1.0"
  }
}
