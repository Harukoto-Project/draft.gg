{
  "name": "@draftgg/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "dev:worker": "wrangler dev --env-file ../../.env",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "cf-typegen": "wrangler types",
    "deploy": "wrangler deploy",
    "typecheck": "wrangler types && tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@draftgg/data-sources": "workspace:*",
    "@draftgg/db": "workspace:*",
    "@draftgg/engine": "workspace:*",
    "@draftgg/shared": "workspace:*",
    "@hono/node-server": "^2.1.6",
    "better-auth": "^1.7.18",
    "hono": "^4.13.16",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  }
}
